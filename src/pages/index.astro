---
import '../styles/style.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Felix d'Hermillion | Far Green Country</title>
    <link
      rel="icon"
      href="https://img.icons8.com/?size=100&id=lqdmaqwWhoiz&format=png&color=000000"
      type="image/x-icon"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <!-- Header -->
      <header>
        <div class="profile-image">
          <img src="profile.jpg" />
        </div>
        <h1>Felix d'Hermillion</h1>
        <p class="location">
          <i class="fas fa-thin fa-location-dot"></i> Chicago, IL
        </p>
        <p class="description">Ecommerce Specialist | Musician | Teacher</p>

        <div class="social-links">
          <a
            href="https://www.youtube.com/channel/UCdo8ZoOlp4XHM8zcO9KuU-g"
            title="YouTube"
            target="_blank"
          >
            <i class="fab fa-youtube"></i>
          </a>
          <a
            href="https://www.linkedin.com/in/felix-d-hermillon-491071238/"
            title="LinkedIn"
            target="_blank"
          >
            <i class="fab fa-linkedin"></i>
          </a>
          <a
            href="https://music.apple.com/us/artist/felix-dhermillon/1830180868"
            title="Apple Music"
            target="_blank"
          >
            <i class="fab fa-itunes-note"></i>
          </a>
          <a
            href="https://open.spotify.com/artist/5VjIUuWwje6nxl9rERMg4j"
            title="Spotify"
            target="_blank"
          >
            <i class="fab fa-spotify"></i>
          </a>
          <a href="https://www.instagram.com/felixdhermillon/" title="Instagram" target="_blank">
            <i class="fab fa-instagram"></i>
          </a>
          <a href="https://www.threads.com/@felixdhermillon" title="Threads" target="_blank">
            <i class="fab fa-threads"></i>
          </a>
        </div>
      </header>

      <!-- Main Cards -->
      <main>
        <a
          href="https://www.instagram.com/far.green.country"
          target="_blank"
          style="text-decoration: none; color: inherit;"
        >
          <div class="card">
            <div class="icon">
              <img src="far_green_country.jpg" alt="Portafolio" />
            </div>
            <div class="card-content">
              <h2>Instagram - Far&nbsp;Green&nbsp;Country</h2>
            </div>
          </div>
        </a>
        <div class="card song-card">
          <a
            class="song-card-link"
            href="https://open.spotify.com/track/0pwhpAIykVjUu9ur3iKr9o"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="icon">
              <img src="weaving_spiders.webp" alt="Weaving Spiders cover art" />
            </div>
            <div class="card-content">
              <h2>Weaving Spiders - Far&nbsp;Green&nbsp;Country</h2>
              <p>Latest Single</p>
            </div>
          </a>
          <div class="listening-links" aria-label="Places to listen">
            <a
              href="https://open.spotify.com/track/0pwhpAIykVjUu9ur3iKr9o"
              target="_blank"
              rel="noopener noreferrer">Spotify</a
            >
            <a
              href="https://music.apple.com/us/artist/felix-dhermillon/1830180868"
              target="_blank"
              rel="noopener noreferrer">Apple Music</a
            >
            <a
              href="https://geo.music.apple.com/us/album/_/1850291287?app=itunes&at=1000lHKX&i=1850291288&itscg=30200&itsct=lt_m&ls=1&mt=1"
              target="_blank"
              rel="noopener noreferrer">iTunes</a
            >
            <a
              href="https://www.youtube.com/watch?v=FAhpmjuBZI0"
              target="_blank"
              rel="noopener noreferrer">YouTube</a
            >
            <a
              href="https://music.youtube.com/watch?v=FAhpmjuBZI0"
              target="_blank"
              rel="noopener noreferrer">YouTube Music</a
            >
            <a
              href="https://tidal.com/album/470535781/track/470535782"
              target="_blank"
              rel="noopener noreferrer">Tidal</a
            >
            <a href="https://www.amazon.com/dp/B0FYKLK487" target="_blank" rel="noopener noreferrer"
              >Amazon</a
            >
            <a
              href="https://music.amazon.com/albums/B0FYKL8M9G?trackAsin=B0FYKLK487"
              target="_blank"
              rel="noopener noreferrer">Amazon Music</a
            >
            <a
              href="https://www.pandora.com/artist/far-green-country/weaving-spiders/weaving-spiders/TR79g72tl9lpnxq"
              target="_blank"
              rel="noopener noreferrer">Pandora</a
            >
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
